diff --git a/.github/workflows/open-agent-branch-prs.yml b/.github/workflows/open-agent-branch-prs.yml
new file mode 100644
index 0000000..96dc4d9
--- /dev/null
+++ b/.github/workflows/open-agent-branch-prs.yml
@@ -0,0 +1,138 @@
+name: Open Agent Branch Pull Requests
+
+on:
+  push:
+    branches:
+      - chatgpt
+      - jules
+      - codex
+  workflow_dispatch:
+    inputs:
+      source_branch:
+        description: Agent branch to propose for merging into main
+        required: true
+        default: chatgpt
+        type: choice
+        options:
+          - chatgpt
+          - jules
+          - codex
+
+permissions:
+  contents: read
+  pull-requests: write
+
+concurrency:
+  group: open-agent-branch-pr-${{ github.event_name == 'workflow_dispatch' && inputs.source_branch || github.ref_name }}
+  cancel-in-progress: true
+
+jobs:
+  open-pull-request:
+    name: Open pull request into main
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Open or reuse pull request
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const sourceBranch = context.eventName === 'workflow_dispatch'
+              ? core.getInput('source_branch')
+              : context.ref.replace('refs/heads/', '');
+
+            const baseBranch = 'main';
+            const allowedBranches = new Set(['chatgpt', 'jules', 'codex']);
+            const { owner, repo } = context.repo;
+
+            if (!allowedBranches.has(sourceBranch)) {
+              core.setFailed(`Unsupported source branch: ${sourceBranch}`);
+              return;
+            }
+
+            if (sourceBranch === baseBranch) {
+              core.info('Source branch is main; nothing to do.');
+              return;
+            }
+
+            await github.rest.repos.getBranch({
+              owner,
+              repo,
+              branch: sourceBranch,
+            });
+
+            await github.rest.repos.getBranch({
+              owner,
+              repo,
+              branch: baseBranch,
+            });
+
+            const comparison = await github.rest.repos.compareCommitsWithBasehead({
+              owner,
+              repo,
+              basehead: `${baseBranch}...${sourceBranch}`,
+            });
+
+            if (comparison.data.ahead_by === 0) {
+              core.info(`${sourceBranch} has no commits ahead of ${baseBranch}; no pull request needed.`);
+              return;
+            }
+
+            const existing = await github.rest.pulls.list({
+              owner,
+              repo,
+              state: 'open',
+              base: baseBranch,
+              head: `${owner}:${sourceBranch}`,
+              per_page: 10,
+            });
+
+            const title = `Merge ${sourceBranch} into ${baseBranch}`;
+            const body = [
+              `This pull request was opened automatically after a push to \`${sourceBranch}\`.`,
+              '',
+              'Purpose:',
+              `- review and merge changes from \`${sourceBranch}\` into \`${baseBranch}\`;`,
+              '- keep Google AI Studio-managed `main` updated through pull requests rather than direct ChatGPT/Jules/Codex pushes.',
+              '',
+              'Notes:',
+              '- This workflow does not force-push or reset any branch.',
+              '- If the pull request already exists, the workflow reuses it instead of creating a duplicate.',
+              '- Resolve conflicts manually in the pull request if GitHub cannot merge automatically.',
+              '',
+              `Source branch: \`${sourceBranch}\``,
+              `Base branch: \`${baseBranch}\``,
+              `Commits ahead: ${comparison.data.ahead_by}`,
+            ].join('\n');
+
+            if (existing.data.length > 0) {
+              const pr = existing.data[0];
+              core.info(`Open pull request already exists: #${pr.number} ${pr.html_url}`);
+              await github.rest.pulls.update({
+                owner,
+                repo,
+                pull_number: pr.number,
+                title,
+                body,
+              });
+              core.summary
+                .addHeading('Pull request already exists')
+                .addLink(`#${pr.number}: ${pr.title}`, pr.html_url)
+                .write();
+              return;
+            }
+
+            const created = await github.rest.pulls.create({
+              owner,
+              repo,
+              title,
+              head: sourceBranch,
+              base: baseBranch,
+              body,
+              maintainer_can_modify: true,
+            });
+
+            core.info(`Created pull request: #${created.data.number} ${created.data.html_url}`);
+            core.summary
+              .addHeading('Pull request created')
+              .addLink(`#${created.data.number}: ${created.data.title}`, created.data.html_url)
+              .write();
