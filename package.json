{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "verify:no-schema-mirror": "node scripts/verifyNoSchemaMirror.mjs",
    "validate:public-samples:images": "node --import tsx scripts/validatePublicSamples.ts",
    "generate:efu": "tsx scripts/generate-efu.ts",
    "test:unit": "node scripts/test-runner.js unit",
    "test:coverage": "node scripts/test-runner.js all --coverage",
    "test:integration": "node scripts/test-runner.js integration",
    "test:architecture": "node scripts/test-runner.js architecture",
    "test:all": "node scripts/test-runner.js all"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.20.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "officeparser": "^7.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "sharp": "^0.35.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
