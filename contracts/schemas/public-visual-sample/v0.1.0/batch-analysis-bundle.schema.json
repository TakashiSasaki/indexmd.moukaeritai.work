{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://indexmd.moukaeritai.work/contracts/schemas/public-visual-sample/v0.1.0/batch-analysis-bundle.schema.json",
  "title": "Visual Analysis Public Sample Batch Analysis Bundle",
  "description": "Recommended single-file artifact for ChatGPT-assisted analysis of visual public sample batch regressions.",
  "x-contract-id": "public-visual-sample.batch-analysis-bundle",
  "x-contract-version": "v0.1.0",
  "x-contract-status": "rc",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "reportKind",
    "generatedAt",
    "modelName",
    "total",
    "successCount",
    "failureCount",
    "counterConsistency",
    "comparisonCoverage",
    "comparisonRecordConsistency",
    "invariants",
    "analysisGuidance",
    "failures",
    "items",
    "artifactIntegrity"
  ],
  "properties": {
    "reportKind": {
      "type": "string",
      "const": "visualAnalysisPublicSampleBatchAnalysisBundle"
    },
    "generatedAt": {
      "type": "string"
    },
    "modelName": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "successCount": {
      "type": "integer"
    },
    "failureCount": {
      "type": "integer"
    },
    "counterConsistency": {
      "type": "object",
      "additionalProperties": true
    },
    "comparisonWarningSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "comparisonCoverage": {
      "type": "object",
      "additionalProperties": true
    },
    "comparisonRecordConsistency": {
      "type": "object",
      "additionalProperties": true
    },
    "invariants": {
      "type": "object",
      "additionalProperties": true
    },
    "analysisGuidance": {
      "type": "object",
      "additionalProperties": true
    },
    "failures": {
      "type": "object",
      "description": "Lightweight failure references; full canonical records live in items.",
      "additionalProperties": true,
      "properties": {
        "totalFailures": {
          "type": "number"
        },
        "itemRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Failure reference",
            "additionalProperties": true
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "artifactIntegrity": {
      "type": "object",
      "properties": {
        "endSentinel": {
          "type": "string",
          "const": "END_OF_VISUAL_ANALYSIS_BATCH_ANALYSIS_BUNDLE"
        }
      },
      "additionalProperties": true
    },
    "comparisonEligibleCount": {
      "type": "integer"
    },
    "successfulWithoutComparisonCount": {
      "type": "integer"
    },
    "notComparableCount": {
      "type": "integer"
    },
    "generationFailureCount": {
      "type": "integer"
    },
    "comparisonOnlyFailCount": {
      "type": "integer"
    },
    "imageExpansionMetrics": {
      "type": "object",
      "additionalProperties": true
    },
    "comparisonFailureSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "textHeavyEvaluation": {
      "type": "object",
      "additionalProperties": true
    },
    "inputSizeSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "mediaResolutionMetrics": {
      "type": "object",
      "additionalProperties": true
    },
    "bundleSchemaVersion": {
      "type": "string",
      "description": "Analysis Bundle schema version."
    },
    "snapshot": {
      "type": "object",
      "description": "Snapshot generation metadata, including generatedAt and terminal state.",
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "description": "Server batch job identity, lifecycle timestamps, revision, and pending/blocked sample IDs.",
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "description": "Execution-stage counters partitioning succeeded, terminal failed, quota blocked, and pending items.",
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "description": "Validation-stage counters scoped to generated records.",
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "description": "Comparison-stage counters scoped to comparable outputs plus explicit not-comparable reasons.",
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "description": "Human-review-stage counters scoped independently from execution failures.",
      "additionalProperties": true
    },
    "errorCatalog": {
      "type": "array",
      "description": "Deduplicated safe provider error catalog referenced by items/failure refs.",
      "items": {
        "type": "object",
        "description": "Safe deduplicated error entry.",
        "additionalProperties": true
      }
    },
    "notComparableDefinition": {
      "type": "string"
    }
  }
}
