{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://indexmd.moukaeritai.work/contracts/schemas/text-analysis-record/v0.1.0/schema.json",
  "title": "Text Analysis Record Schema v0.1.0",
  "description": "Envelope schema for text analysis results including asset metadata, execution details, semantic analysis, evaluation, and diagnostics.",
  "x-contract-id": "text-analysis-record",
  "x-contract-version": "v0.1.0",
  "x-contract-status": "rc",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "assetMetadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "text-analysis-record.v0.1.0"
    },
    "status": {
      "type": "object",
      "required": [
        "success"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "failureKind": {
          "type": "string",
          "enum": [
            "providerError",
            "emptyStructuredOutput",
            "underGeneratedStructuredOutput",
            "jsonParseError",
            "schemaValidationError",
            "controlledVocabularyValidationError",
            "repairFallbackFailed",
            "qualityGateFailed",
            "unknown"
          ]
        }
      }
    },
    "assetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "googleDrive",
            "publicSample",
            "upload",
            "local",
            "unknown"
          ]
        },
        "path": {
          "type": "string"
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceProvider": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "modifiedAt": {
          "type": "string"
        }
      }
    },
    "technicalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "byteLength": {
          "type": "number"
        },
        "encoding": {
          "type": "string"
        },
        "originalTextLength": {
          "type": "number"
        },
        "extractedTextLength": {
          "type": "number"
        },
        "contentSampleLength": {
          "type": "number"
        },
        "truncated": {
          "type": "boolean"
        },
        "truncationLimit": {
          "type": "number"
        },
        "textExtractionMethod": {
          "type": "string"
        },
        "ocrUsed": {
          "type": "boolean"
        },
        "pageCount": {
          "type": "number"
        },
        "lineCount": {
          "type": "number"
        }
      }
    },
    "summaryAnalysis": {
      "description": "SummaryAnalysisResultV12 as semantic payload. Separately validated.",
      "type": "object",
      "additionalProperties": true
    },
    "analysisRun": {
      "type": "object",
      "required": [
        "runId",
        "timestamp",
        "model",
        "execution",
        "schema",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "providerFamily": {
              "type": "string"
            },
            "structuredRecommendation": {
              "type": "string"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outputMode": {
              "type": "string"
            },
            "structuredExecutionMode": {
              "type": "string"
            },
            "jsonMode": {
              "type": "string"
            },
            "customSchemaUsed": {
              "type": "boolean"
            },
            "responseSchemaEnabled": {
              "type": "boolean"
            },
            "repairApplied": {
              "type": "boolean"
            },
            "repairFallbackUsed": {
              "type": "boolean"
            }
          }
        },
        "schema": {
          "type": "object",
          "required": [
            "resultSchemaVersion",
            "recordSchemaVersion"
          ],
          "additionalProperties": false,
          "properties": {
            "resultSchemaVersion": {
              "type": "string"
            },
            "recordSchemaVersion": {
              "type": "string"
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summaryPromptVersion": {
              "type": "string"
            },
            "systemInstructionVersion": {
              "type": "string"
            },
            "customInstructionUsed": {
              "type": "boolean"
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceKind": {
              "type": "string"
            },
            "fileId": {
              "type": "string"
            },
            "mimeType": {
              "type": [
                "string",
                "null"
              ]
            },
            "byteLength": {
              "type": "number"
            },
            "contentSampleLength": {
              "type": "number"
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualityStatus": {
          "type": "string",
          "enum": [
            "valid",
            "validWithRepair",
            "validLowQuality",
            "invalid"
          ]
        },
        "qualityScore": {
          "type": "number"
        },
        "qualityIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "blocking"
                ]
              }
            }
          }
        },
        "recommendedForPersistence": {
          "type": "boolean"
        },
        "recommendedForIndexMdCandidate": {
          "type": "boolean"
        },
        "experimentalModel": {
          "type": "boolean"
        },
        "reviewStatus": {
          "type": "string"
        },
        "reviewReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {},
        "extraction": {},
        "generation": {},
        "response": {},
        "parse": {},
        "normalization": {},
        "repair": {},
        "validation": {},
        "retry": {}
      }
    }
  }
}