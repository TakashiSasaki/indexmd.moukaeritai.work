{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://indexmd.moukaeritai.work/contracts/api/v0.1.0/visual-public-samples-analyze.request.schema.json",
  "title": "Visual Public Sample Analyze Request",
  "x-contract-id": "visual-public-samples-analyze.request",
  "x-contract-version": "v0.1.0",
  "x-contract-status": "rc",
  "type": "object",
  "required": [
    "sampleId"
  ],
  "properties": {
    "sampleId": {
      "type": "string",
      "description": "The unique public sample identifier."
    },
    "modelName": {
      "type": "string",
      "description": "Optional name of the target Gemini model to evaluate (defaults to gemini-3.5-flash)."
    },
    "includeRequestPreview": {
      "type": "boolean",
      "description": "Whether to include raw model prompt structures in the response diagnostic block."
    },
    "jsonMode": {
      "type": "string",
      "enum": ["native_schema", "prompt_only"],
      "description": "Forces structural execution mode."
    },
    "customInstruction": {
      "type": "string",
      "description": "Optional system prompt adjustment or custom json schema injection."
    }
  },
  "additionalProperties": false
}
