{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Image Analysis Record v0.1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "image-analysis-record.v0.1.0"
    },
    "status": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "error": { "type": "string" },
        "failureKind": { "type": "string" }
      },
      "required": ["success"],
      "additionalProperties": false
    },
    "assetMetadata": {
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "sourceKind": { "type": "string" },
        "fileId": { "type": "string" },
        "sampleId": { "type": "string" },
        "sourceProvider": { "type": "string" },
        "sourcePageUrl": { "type": "string" },
        "licenseKind": { "type": "string" },
        "licenseName": { "type": "string" },
        "attributionText": { "type": "string" }
      },
      "additionalProperties": false
    },
    "technicalMetadata": {
      "type": "object",
      "properties": {
        "mimeType": { "type": "string" },
        "originalDimensions": {
          "type": "object",
          "properties": { "width": { "type": "number" }, "height": { "type": "number" } },
          "additionalProperties": false
        },
        "processedDimensions": {
          "type": "object",
          "properties": { "width": { "type": "number" }, "height": { "type": "number" } },
          "additionalProperties": false
        },
        "originalByteLength": { "type": "number" },
        "processedByteLength": { "type": "number" },
        "base64Length": { "type": "number" },
        "inputFormat": { "type": "string" },
        "outputFormat": { "type": "string" },
        "resized": { "type": "boolean" },
        "recompressed": { "type": "boolean" },
        "reencoded": { "type": "boolean" },
        "quality": { "type": "number" },
        "analysisSizingPolicy": { "type": "string" },
        "analysisTargetLongEdge": { "type": "number" },
        "analysisTargetBytes": { "type": "number" },
        "analysisHardCapBytes": { "type": "number" },
        "analysisSizeReductionRatio": { "type": "number" },
        "targetExceededButAccepted": { "type": "boolean" },
        "hardCapExceeded": { "type": "boolean" },
        "minQualityReached": { "type": "boolean" },
        "providerSafeMimeType": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "visualAnalysis": {
      "type": "object",
      "additionalProperties": true
    },
    "analysisRun": {
      "type": "object",
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "expectedMetadata": {},
        "comparison": {},
        "qualityStatus": { "type": "string" },
        "qualityScore": { "type": "number" },
        "qualityIssues": { "type": "array", "items": { "type": "string" } },
        "reviewStatus": { "type": "string" },
        "reviewReasons": { "type": "array", "items": { "type": "string" } },
        "reviewNotes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "input": {},
        "parse": {},
        "normalization": {},
        "generation": {},
        "response": {},
        "retry": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "status", "assetMetadata"],
  "additionalProperties": false
}
